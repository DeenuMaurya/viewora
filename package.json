{
  "name": "viewora",
  "version": "0.1.0",
  "description": "Viewora: create and share interactive 3D walkthroughs",
  "main": "backend/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "test": "node --test",
    "lint": "eslint backend frontend/public/js test",
    "format:check": "prettier --check \"**/*.{js,json,md,html,css,yml}\"",
    "backup": "node backend/scripts/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nanoid": "^3.3.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.9.6"
  }
}
