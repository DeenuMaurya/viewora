# Copy this file to backend/.env and replace JWT_SECRET before starting Viewora.
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Per-account safeguards for the local single-server version.
MAX_PROJECTS_PER_USER=20
MAX_STORAGE_BYTES_PER_USER=1073741824

# Vercel / Supabase production provider. Keep these server-side only: never
# put SUPABASE_SERVICE_ROLE_KEY into HTML or frontend JavaScript.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=viewora-assets
